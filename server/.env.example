# Copie para .env e preencha

# Connection string do Postgres (Supabase: Project Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres:SENHA@db.xxxxx.supabase.co:5432/postgres

# true para Supabase/Neon (conexão com SSL); false para Postgres local
DATABASE_SSL=true

# Segredo para assinar os tokens do painel (gere uma string longa e aleatória)
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# Endereço do frontend (CORS). Vários separados por vírgula
CLIENT_URL=http://localhost:5173

PORT=3001

# Supabase Storage para as fotos dos produtos (opcional em desenvolvimento:
# sem estas variáveis as fotos ficam salvas na pasta server/uploads)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=produtos

# Primeiro usuário administrador (usado por npm run db:setup)
ADMIN_NOME=Airon
ADMIN_EMAIL=admin@oticamd.com.br
ADMIN_SENHA=troque-esta-senha
